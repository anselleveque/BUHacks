# Copy this file to .env (which git ignores) and fill in your own keys. Never commit .env or paste keys into chat.
# Real environment variables override .env. The app still runs without any of these (with fewer features).

# MBTA V3 API (https://api-v3.mbta.com): nearby stops and next departures.
# Free key at https://api-v3.mbta.com/register. Without it the API allows about 20 requests a minute.
MBTA_API_KEY=

# OpenRouteService (https://openrouteservice.org): walking routes. Kept on the server, never sent to the browser.
# Without it the app uses the free OpenStreetMap foot-routing server.
ORS_API_KEY=

# MapTiler (https://www.maptiler.com): map tiles. This key IS visible in the browser (it is part of the tile URL),
# so restrict it to your allowed origins (localhost and your demo domain) in the MapTiler dashboard.
# Without it the map uses plain OpenStreetMap tiles.
MAPTILER_API_KEY=
