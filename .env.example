# Copy to .env (never commit .env). All keys are optional; the app degrades gracefully without them.

# MBTA V3 API key: https://api-v3.mbta.com/ (free). Without a key the MBTA limits you to about 20 requests a minute,
# which is too few for trip planning; with a key plans are much faster.
MBTA_API_KEY=

# OpenRouteService key: https://openrouteservice.org/dev/#/signup (free tier, about 40 requests a minute).
# Optional: walking routes fall back to public OSRM and Valhalla servers, then to an estimate.
ORS_API_KEY=

# MapTiler key: https://www.maptiler.com/ (free tier). Optional: the map falls back to OpenStreetMap tiles.
# This key is public in the browser by design; restrict it to your own origins in the MapTiler dashboard.
MAPTILER_API_KEY=
